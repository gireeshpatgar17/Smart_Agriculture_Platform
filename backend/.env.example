# ============================================================
# SMART FARMING BACKEND ENVIRONMENT CONFIGURATION
# ============================================================

# Groq Cloud API Key for AI Agent (Phase 1)
# Sign up and get your free API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Selection (default: llama-3.3-70b-versatile or llama-3.1-8b-instant)
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase Database Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key

# Blynk IoT Cloud Configuration
BLYNK_SERVER=https://blynk.cloud
BLYNK_TOKEN=your_blynk_device_auth_token
